# Copy to .env and adjust. Every value has a safe default in backend/app/config.py.

# HTTP server
HANF_HOST=127.0.0.1
HANF_PORT=8000

# Redis shards. The first HANF_INITIAL_SHARDS are active at start; the rest are spare
# shards used by "Add shard and rebalance".
HANF_REDIS_HOST=127.0.0.1
HANF_REDIS_PORTS=7001,7002,7003,7004,7005
HANF_INITIAL_SHARDS=4
HANF_VNODES=128
# live = real Redis servers; emulated = in-process fakeredis (clearly labelled, for machines without Redis)
HANF_REDIS_MODE=live
# Redis logical DB used by the live app (experiments use HANF_EXPERIMENT_DB and clean it afterwards)
HANF_REDIS_DB=0
HANF_EXPERIMENT_DB=1

# Optional engines (only reported as connected after a real round trip succeeds)
HANF_MONGO_ENABLED=true
HANF_MONGO_URI=mongodb://127.0.0.1:27017
HANF_CASSANDRA_ENABLED=true
HANF_CASSANDRA_HOSTS=127.0.0.1
HANF_CASSANDRA_PORT=9042

# Router: if the preferred engine is down, fall back to the Redis key-value path (flagged in the decision)
HANF_ROUTER_FALLBACK_TO_KV=true

# Security monitor
HANF_SECURITY_WINDOW=100
HANF_SECURITY_BATCH=20
# async = background worker (default), batched = inline every BATCH windows, sync = inline per window, off
HANF_SECURITY_MODE=async
HANF_SECURITY_CONTAMINATION=0.02

# Consistency controller staleness objective (fraction of reads)
HANF_STALENESS_SLO=0.01

# Report builder only (reports/build_report.py): register numbers, comma separated, in author order
# REPORT_AUTHOR_REG_NOS=

# Telemetry retention (number of events kept in memory)
HANF_TELEMETRY_MAX_EVENTS=5000
